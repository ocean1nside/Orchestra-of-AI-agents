# Скопируйте в `.env` в корне репозитория (рядом с этим файлом):
#   copy env.example .env
# Запускайте docker compose из корня репозитория, чтобы подтянулись переменные для ${...} в compose.

# --- Postgres (docker-compose + приложения) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=orchestrator

# --- orchestrator-api + indexing-worker ---
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/orchestrator
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge_chunks
STORAGE_PATH=/storage/knowledge
# Пока не используется кодом оркестратора: зарезервировано под будущую защиту admin API.
API_KEY_DEV=change-me

# Индексация (эмбеддинги): hash | openai
EMBED_PROVIDER=hash
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIMENSIONS=384

# --- vendor-support-agent ---
AGENT_QDRANT_COLLECTION=knowledge_chunks
AGENT_EMBED_PROVIDER=hash
AGENT_OPENAI_API_KEY=
AGENT_VECTOR_DIMENSIONS=384

LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

TELEGRAM_BOT_TOKEN=
# Совпадает с secret_token в setWebhook; Telegram шлёт заголовок X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
MAX_BOT_TOKEN=
# Секрет из подписки webhook (POST /subscriptions, поле secret); заголовок X-Max-Bot-Api-Secret.
MAX_WEBHOOK_SECRET=
# База API MAX (по умолчанию production).
MAX_API_BASE=https://platform-api.max.ru

# Ключ для внешнего виджета (и для POST /api/v1/invoke). Пусто = без проверки (только dev).
# Сгенерировать: openssl rand -hex 32   или  [Convert]::ToBase64String((1..24|%{Get-Random -Max 256}))
WIDGET_API_KEY=

# --- orchestrator: проверки /api/v1/infrastructure/status ---
VENDOR_SUPPORT_AGENT_BASE_URL=http://vendor-support-agent:8010
