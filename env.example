# Скопируйте в `.env` в корне репозитория:
#   copy env.example .env
#
# В корне достаточно POSTGRES_* (docker-compose + контейнер postgres).
# Настройки приложений — в отдельных файлах (подмешиваются поверх корня):
#   copy apps\orchestrator-api\.env.example apps\orchestrator-api\.env
#   copy apps\agents\vendor-support-agent\.env.example apps\agents\vendor-support-agent\.env
# Подробнее: docs/handover/environment.md

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=orchestrator
