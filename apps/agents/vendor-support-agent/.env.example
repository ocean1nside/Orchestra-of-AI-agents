# Скопируйте в `.env` в ЭТОЙ папке: copy .env.example .env
# Docker Compose подмешивает его после корневого `.env` (в корне только POSTGRES_*; см. docs/handover/environment.md).
# Префикс AGENT_* не используется — только переменные ниже (как в settings.py).

APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/orchestrator
QDRANT_URL=http://qdrant:6333
LLM_PROVIDER=openai
LLM_API_KEY=
# Модель для OpenAI Chat Completions (`https://api.openai.com/v1/chat/completions`).
# Задаётся отдельно для каждого агента в его `apps/agents/<agent>/.env` (Docker подмешивает этот файл).
# Пусто — в коде подставится `gpt-4o-mini`.
# Примеры: `gpt-4o-mini` (дешёвая «мини»), `gpt-4.1-mini` или снапшот `gpt-4.1-mini-2025-04-14`.
LLM_MODEL=gpt-4o-mini
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_API_BASE=https://platform-api.max.ru

WIDGET_API_KEY=
# API консоли оператора (список чатов / ответ). Пусто — для operator API используется WIDGET_API_KEY.
OPERATOR_API_KEY=

# Эскалация: ID супергруппы Telegram (вид -100…). Бот должен быть в группе админом.
# Пусто = уведомления операторам не отправляются.
ESCALATION_TELEGRAM_CHAT_ID=
# Необязательно: база URL «открыть контекст» для widget/max (добавятся query channel, conversation_id, user_id).
ESCALATION_CONTEXT_BASE_URL=

QDRANT_COLLECTION=knowledge_chunks
EMBED_PROVIDER=hash
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIMENSIONS=384

