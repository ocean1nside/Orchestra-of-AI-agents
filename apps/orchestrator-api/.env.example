# Скопируйте в `.env` в ЭТОЙ папке (рядом с pyproject.toml):
#   copy .env.example .env
# Docker Compose подхватывает файл вторым слоем после корневого `.env` (там только POSTGRES_*).

APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/orchestrator
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge_chunks
STORAGE_PATH=/storage/knowledge
API_KEY_DEV=change-me
ORCHESTRATOR_REQUIRE_API_KEY=false

EMBED_PROVIDER=hash
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIMENSIONS=384
# Подготовка документов БЗ через Chat Completions (Studio: «Подготовить через ИИ»)
KNOWLEDGE_NORMALIZE_MODEL=gpt-4o-mini
# Вкладка «Тюнинг» в Studio — правка промптов по жалобе оператора
PROMPT_TUNE_MODEL=gpt-4o-mini

VENDOR_SUPPORT_AGENT_BASE_URL=http://vendor-support-agent:8010
